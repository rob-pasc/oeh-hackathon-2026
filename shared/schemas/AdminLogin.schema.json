{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AdminLogin.schema.json",
  "title": "AdminLogin",
  "type": "object",
  "required": [
    "username",
    "password"
  ],
  "properties": {
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "additionalProperties": false
}
