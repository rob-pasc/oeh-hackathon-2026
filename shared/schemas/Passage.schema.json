{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Passage.schema.json",
  "title": "Passage",
  "type": "object",
  "required": [
    "passage_id",
    "document_id",
    "title",
    "url",
    "publisher",
    "topic",
    "section",
    "page",
    "applicability",
    "accessed_on",
    "text"
  ],
  "properties": {
    "passage_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "enum": [
        "repair-hardware",
        "software-support",
        "environmental",
        "circular-economy"
      ]
    },
    "section": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "page": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "applicability": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "manufacturer",
            "model"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "model"
            },
            "manufacturer": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "const": "generic"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "accessed_on": {
      "type": "string",
      "format": "date"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "corpus",
        "web"
      ],
      "description": "web = found by web search for this model (feature 017); absent = corpus"
    }
  },
  "additionalProperties": false,
  "description": "At least one of section or page is non-null (checked in invariants.ts)"
}
