{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "LocationRequest.schema.json",
  "title": "LocationRequest",
  "type": "object",
  "required": [
    "lat",
    "lon"
  ],
  "properties": {
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    }
  },
  "additionalProperties": false
}
