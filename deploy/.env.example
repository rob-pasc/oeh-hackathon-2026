# Settings for deploy/compose.yaml. Copy to deploy/.env (gitignored) on the host and fill in.
# Never commit real keys.
#
# Compose reads this file to fill in the image tag and ports, and also passes all of it to the
# server container as its environment. The extra Compose variables there are harmless.

# --- Compose: images and ports ---

# Registry namespace and image tag to run. A Git tag such as v0.1.0 pins a release; "latest" is
# the most recently tagged build.
LEAAF_REGISTRY=ghcr.io/rob-pasc
LEAAF_TAG=latest

# Loopback ports the external Caddy proxies to.
WEB_PORT=8080
SERVER_PORT=3000

# --- Server: HTTP API (described in server/README.md) ---

# Public origin of the site; device page links are built from it.
PUBLIC_BASE_URL=https://leaaf.green

# --- Server: LLM (described in server/README.md) ---

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=25000
LLM_THINKING_FACT_EXTRACTION=enabled
LLM_THINKING_EXPLANATION=disabled
