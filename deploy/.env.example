# Settings for deploy/compose.yaml. Copy to deploy/.env (gitignored) on the host and fill in.
# Never commit real keys.
#
# Compose reads this file to fill in the image tag and ports, and also passes all of it to the
# server container as its environment. The extra Compose variables there are harmless.

# --- Compose: images and ports ---

# Registry namespace and image tag to run. A Git tag such as v0.1.0 pins a release; "latest" is
# the most recently tagged build.
LEAAF_REGISTRY=ghcr.io/rob-pasc
LEAAF_TAG=latest

# Host ports the external Caddy proxies to. Keep them closed to the outside in the host firewall.
WEB_PORT=8080
SERVER_PORT=3000

# --- Server: HTTP API (described in server/README.md) ---

# Public origin of the site; device page links are built from it.
PUBLIC_BASE_URL=https://leaaf.green

# --- Server: LLM (described in server/README.md) ---

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=25000
LLM_CATEGORY_TIMEOUT_MS=40000
LLM_STEP_TIMEOUT_MS=25000
LLM_THINKING_FACT_EXTRACTION=disabled
LLM_THINKING_EXPLANATION=disabled
LLM_THINKING_CATEGORIES=disabled
LLM_THINKING_STEPS=disabled
LLM_THINKING_WEB_EXTRACTION=disabled

# API request limits. Set the proxy address only on a proxy-exclusive ingress path.
UPLOAD_MAX_BYTES=32768
UPLOADS_PER_HOUR=10
REPORTS_PER_HOUR=60
STEPS_PER_HOUR=120
LLM_DAILY_CALLS=200
TRUSTED_PROXY_IP=

# Web search for models and topics the corpus does not cover (feature 017). Without any key,
# web search is off. SEARCH_PROVIDER is asked first, SEARCH_FALLBACK second (or `none`).
LANGSEARCH_API_KEY=
TINYFISH_API_KEY=
SEARCH_PROVIDER=langsearch
SEARCH_FALLBACK=tinyfish
SEARCH_DAILY_CALLS=200
SEARCH_TIMEOUT_MS=20000

# Admin area at /admin (feature 016): one login for the team. Leave either empty to keep the admin
# area off (all /api/admin/* routes answer 404). The password needs at least 16 characters, or the
# admin area stays off with a warning. It is stored here in plain text: keep this file private.
ADMIN_USERNAME=
ADMIN_PASSWORD=
