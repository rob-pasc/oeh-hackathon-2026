# Environment for the server container. Copy to deploy/server.env (gitignored) on the host and
# fill in. Never commit real keys. Variables are described in server/README.md.

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_MS=25000
LLM_THINKING_FACT_EXTRACTION=enabled
LLM_THINKING_EXPLANATION=disabled
