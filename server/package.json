{
  "name": "@leaaf/server",
  "version": "0.1.0",
  "private": true,
  "description": "leaaf backend: API, retrieval, assessment, and LLM integration",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prestart": "npm run build -w @leaaf/shared",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "llm:smoke": "node --env-file-if-exists=.env scripts/llm-smoke.ts",
    "facts:smoke": "node --env-file-if-exists=.env scripts/facts-smoke.ts",
    "categories:smoke": "node --env-file-if-exists=.env scripts/categories-smoke.ts",
    "steps:smoke": "node --env-file-if-exists=.env scripts/steps-smoke.ts",
    "search:smoke": "node --env-file-if-exists=.env scripts/search-smoke.ts",
    "parts:smoke": "node --env-file-if-exists=.env scripts/parts-smoke.ts",
    "corpus:ingest": "node --env-file-if-exists=.env scripts/corpus-ingest.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@leaaf/shared": "*",
    "fastify": "^5.12.8",
    "openai": "^7.62.0",
    "typebox": "^1.4.7",
    "yaml": "^2.9.1"
  }
}
