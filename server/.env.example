# Copy to server/.env (gitignored) and fill in. Never commit real keys.

# OpenAI-compatible endpoint. Defaults target DeepSeek's official API.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Per-request timeout in milliseconds.
LLM_TIMEOUT_MS=25000
# Deadline for the whole category call (feature 008), which returns more than the other tasks.
LLM_CATEGORY_TIMEOUT_MS=40000
# Deadline for the whole step call of one option (feature 009).
LLM_STEP_TIMEOUT_MS=25000

# Thinking mode per task: enabled | disabled | omit
# (omit sends no thinking parameter, for providers that do not support it).
LLM_THINKING_FACT_EXTRACTION=disabled
LLM_THINKING_EXPLANATION=disabled
LLM_THINKING_CATEGORIES=disabled
LLM_THINKING_STEPS=disabled
LLM_THINKING_WEB_EXTRACTION=disabled

# HTTP API (feature 001). Paths are relative to server/.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/leaaf.sqlite
# Origin of the web app; device page URLs are built from it.
PUBLIC_BASE_URL=http://localhost:5173
# Scanner builds served at /downloads/… (each 404 until it exists): Windows, Linux, and the zipped macOS app.
SCANNER_EXE_PATH=../scanner/dist/leaaf-scanner.exe
SCANNER_LINUX_PATH=../scanner/dist/leaaf-scanner-linux
SCANNER_MACOS_PATH=../scanner/dist/leaaf-scanner-macos.zip

# API request limits. Set the proxy address only on a proxy-exclusive ingress path.
UPLOAD_MAX_BYTES=32768
UPLOADS_PER_HOUR=10
REPORTS_PER_HOUR=60
STEPS_PER_HOUR=120
LLM_DAILY_CALLS=200
TRUSTED_PROXY_IP=

# Web search for models and topics the corpus does not cover (feature 017). Without any key,
# web search is off. SEARCH_PROVIDER is asked first, SEARCH_FALLBACK second (or `none`).
LANGSEARCH_API_KEY=
TINYFISH_API_KEY=
SEARCH_PROVIDER=langsearch
SEARCH_FALLBACK=tinyfish
SEARCH_DAILY_CALLS=200
SEARCH_TIMEOUT_MS=20000

# Admin area at /admin (feature 016): one login for the team. Leave either empty to keep the admin
# area off (all /api/admin/* routes answer 404). The password needs at least 16 characters, or the
# admin area stays off with a warning. It is stored here in plain text: keep this file private.
ADMIN_USERNAME=
ADMIN_PASSWORD=
