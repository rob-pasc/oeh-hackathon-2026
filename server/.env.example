# Copy to server/.env (gitignored) and fill in. Never commit real keys.

# OpenAI-compatible endpoint. Defaults target DeepSeek's official API.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Per-request timeout in milliseconds.
LLM_TIMEOUT_MS=25000

# Thinking mode per task: enabled | disabled | omit
# (omit sends no thinking parameter, for providers that do not support it).
LLM_THINKING_FACT_EXTRACTION=disabled
LLM_THINKING_EXPLANATION=disabled

# HTTP API (feature 001). Paths are relative to server/.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/leaaf.sqlite
# Origin of the web app; device page URLs are built from it.
PUBLIC_BASE_URL=http://localhost:5173
# Scanner builds served at /downloads/… (each 404 until it exists): Windows, Linux, and the zipped macOS app.
SCANNER_EXE_PATH=../scanner/dist/leaaf-scanner.exe
SCANNER_LINUX_PATH=../scanner/dist/leaaf-scanner-linux
SCANNER_MACOS_PATH=../scanner/dist/leaaf-scanner-macos.zip

# API request limits. Set the proxy address only on a proxy-exclusive ingress path.
UPLOAD_MAX_BYTES=32768
UPLOADS_PER_HOUR=10
REPORTS_PER_HOUR=60
LLM_DAILY_CALLS=200
TRUSTED_PROXY_IP=
